{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "UrodLauncher",
	"version": "1.0.0",
	"mainBinaryName": "UrodLauncher",
	"identifier": "ru.gorodurodov.urodlauncher",
	"build": {
		"beforeDevCommand": "pnpm --dir ../app-frontend dev",
		"beforeBuildCommand": "pnpm --dir ../app-frontend build",
		"frontendDist": "../app-frontend/dist",
		"devUrl": "http://localhost:1420"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "UrodLauncher",
				"width": 1240,
				"height": 820,
				"minWidth": 860,
				"minHeight": 620,
				"decorations": true,
				"backgroundColor": "#090909"
			}
		],
		"security": {
			"capabilities": [
				"main"
			],
			"csp": "default-src 'self'; connect-src ipc: http://ipc.localhost 'self'; img-src 'self' data: https://cdn.modrinth.com; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'none'; object-src 'none'"
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": false,
		"targets": [
			"deb",
			"nsis"
		],
		"category": "Game",
		"shortDescription": "Minecraft-лаунчер Города Уродов",
		"copyright": "UrodLauncher contributors. Derived from NCreate Launcher and Modrinth App. GPL-3.0-only.",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.ico"
		],
		"resources": {
			"../../LICENSE": "LICENSE.txt",
			"../../NOTICE.md": "NOTICE.md"
		},
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"displayLanguageSelector": true,
				"languages": [
					"Russian",
					"English"
				],
				"installerIcon": "icons/icon.ico"
			}
		},
		"linux": {
			"deb": {
				"depends": [
					"xdg-utils"
				]
			}
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": [
					"urodlauncher"
				]
			}
		},
		"updater": {
			"pubkey": "",
			"requireSignedVersion": true,
			"endpoints": [],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
